{
  "name": "isotone",
  "version": "1.0.10",
  "type": "module",
  "license": "MIT",
  "description": "Design variants and feedback for your running web app. Switch between variants your coding agent builds, pin elements, and give the agent the context to make the change.",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "docs/assets/preview.png",
    "docs/integrations.md",
    "docs/migration.md",
    "docs/updates.md",
    "docs/variants.md",
    "docs/third-party-notices.md",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "isotone": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check",
    "dev": "vite --config examples/vite.config.ts",
    "build:demo": "vite build --config examples/vite.config.ts --mode hosted",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vite": "^5 || ^6 || ^7 || ^8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.0.1",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^4.1.10",
    "lucide-react": "^1.55.0"
  },
  "keywords": [
    "feedback",
    "review",
    "dev-tool",
    "vite-plugin",
    "coding-agent",
    "annotations",
    "design-review",
    "variants",
    "iteration"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaroi/isotone.git"
  },
  "homepage": "https://github.com/aaroi/isotone#readme",
  "bugs": "https://github.com/aaroi/isotone/issues",
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
