{
  "name": "isotone",
  "version": "1.3.5",
  "type": "module",
  "license": "MIT",
  "description": "Design variants and feedback for your running web app. Switch between variants your coding agent builds, pin elements, and give the agent the context to make the change.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "exports": {
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/agent-guide.md",
    "docs/note.schema.json",
    "docs/integrations.md",
    "docs/updates.md",
    "docs/blast.md",
    "docs/variants.md",
    "docs/third-party-notices.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "isotone": "./dist/bin.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "build": "tsdown",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check",
    "dev": "vite --config examples/vite.config.ts",
    "build:demo": "vite build --config examples/vite.config.ts --mode hosted",
    "check:package": "node scripts/check-package.mjs && publint --strict && attw --pack . --profile esm-only",
    "check:release": "node scripts/check-release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vite": "^5 || ^6 || ^7 || ^8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.7",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.0.1",
    "knip": "^6.44.2",
    "lucide-react": "^1.55.0",
    "publint": "^0.3.25",
    "react": "^19",
    "react-dom": "^19",
    "tsdown": "^0.23.7",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "feedback",
    "review",
    "dev-tool",
    "vite-plugin",
    "coding-agent",
    "annotations",
    "design-review",
    "variants",
    "iteration"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaroi/isotone.git"
  },
  "homepage": "https://github.com/aaroi/isotone#readme",
  "bugs": "https://github.com/aaroi/isotone/issues",
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
